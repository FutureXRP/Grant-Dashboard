# Copy to .env.local and fill in.

# Required for the AI agents (NOFO analyzer, drafter, red-team, compliance check).
# Get a key at https://platform.claude.com — without it, everything else still works.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional: durable cloud storage for uploaded documents via Supabase Storage.
# When both are set, uploads go to a private bucket (auto-created) instead of
# the local data/uploads/ folder. Get these from your Supabase project:
# Settings -> API -> Project URL, and Settings -> API -> service_role key.
# The service_role key bypasses security rules — server-side only, never share it.
# SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=grant-documents

# Cloud database (REQUIRED when hosting on Vercel; leave unset everywhere else).
# Vercel's servers have no permanent disk, so the database must live in Turso
# (hosted SQLite, free tier). Create one at https://turso.tech:
#   turso db create grant-copilot          -> gives the libsql:// URL
#   turso db tokens create grant-copilot   -> gives the auth token
# When these are unset, the app uses the local file data/grant-copilot.db.
# TURSO_DATABASE_URL=libsql://grant-copilot-yourname.turso.io
# TURSO_AUTH_TOKEN=

# Protects the daily-scout cron endpoint on Vercel (any long random string).
# Vercel automatically sends it with each scheduled run; requests without it
# are rejected, so strangers can't trigger runs that spend AI credits.
# CRON_SECRET=
